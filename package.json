{
  "name": "claude-zed-shim",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy exposing Claude Code subscription (Agent SDK) as a provider in Zed Agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavomunix/claude-zed-shim.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:@anthropic-ai/claude-agent-sdk --external:zod --sourcemap --log-level=warning",
    "preserve": "npm run build",
    "serve": "node dist/cli.js serve",
    "models": "node dist/cli.js models",
    "status": "node dist/cli.js status",
    "preself-test": "npm run build",
    "self-test": "node dist/cli.js self-test",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
